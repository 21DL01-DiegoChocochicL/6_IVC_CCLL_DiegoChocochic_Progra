Algoritmo Act1_Lecc7_INC2
	Definir n Como Cadena
	Definir edad Como Entero
	//Entrada
	Escribir 'Digame su nombre: '
	Leer n
	Escribir 'Digame su edad: '
	Leer edad
	//Proceso, Salida y evaluar
	Si edad>=18 Entonces
		Escribir n, ' es mayor de edad, ', edad, ' años'
	SiNo
		Escribir n, ' es menor de edad, ', edad, ' años'
	FinSi
FinAlgoritmo

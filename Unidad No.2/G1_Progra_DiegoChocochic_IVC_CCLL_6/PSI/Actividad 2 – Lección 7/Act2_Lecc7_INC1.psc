Algoritmo Act2_Lecc7_INC1
	// Inicio
	Definir n Como Entero
	Escribir 'Digite los siguientes Numeros (1,2,3,4) para continuar:'
	Leer n
	// Proceso, Evaluar y Salida
	Si n=1 Entonces
		Escribir 'Gracias Por escojer la opcion de Comunicarse a la cental'
	SiNo
		Si n=2 Entonces
			Escribir 'Gracias por escojer la opcion de Comunicarse con el Administrador'
		SiNo
			Si n=3 Entonces
				Escribir 'Gracias por escojer la opcion de Comunicarse con Gerente de Sotfware'
			SiNo
				Si n=4 Entonces
					Escribir 'Gracias por escojer la opcion de Comunicarse con el Encargado de ventas'
				SiNo
					Escribir 'No esta este numero como opcion'
				FinSi
			FinSi
		FinSi
	FinSi
FinAlgoritmo

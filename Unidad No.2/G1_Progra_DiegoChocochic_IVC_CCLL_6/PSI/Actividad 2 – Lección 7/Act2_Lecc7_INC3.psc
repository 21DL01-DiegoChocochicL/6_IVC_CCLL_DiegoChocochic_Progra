Algoritmo Act2_Lecc7_INC3
	// Inicio
	Definir NM Como Real
	Escribir 'Colocar del 1 al 12 para decirle cual mes es: '
	Leer NM
	// Proceso, Salida y evaluar
	Si NM=1 Entonces
		Escribir 'El Mes es Enero'
	SiNo
		Si NM=2 Entonces
			Escribir 'El Mes es Febrero'
		SiNo
			Si NM=3 Entonces
				Escribir 'El Mes es Marzo'
			SiNo
				Si NM=4 Entonces
					Escribir 'El Mes es Abril'
				SiNo
					Si NM=5 Entonces
						Escribir 'El Mes es Mayo'
					SiNo
						Si NM=6 Entonces
							Escribir 'El Mes es Junio'
						SiNo
							Si NM=7 Entonces
								Escribir 'El Mes es Julio'
							SiNo
								Si NM=8 Entonces
									Escribir 'El Mes es Agosto'
								SiNo
									Si NM=9 Entonces
										Escribir 'El Mes es Septiembre'
									SiNo
										Si NM=10 Entonces
											Escribir 'El Mes es Octubre'
										SiNo
											Si NM=11 Entonces
												Escribir 'El Mes es Noviembre'
											SiNo
												Si NM=12 Entonces
													Escribir 'El Mes es Diciembre'
												SiNo
													Escribir 'El Numero no es parte de los meses'
												FinSi
											FinSi
										FinSi
									FinSi
								FinSi
							FinSi
						FinSi
					FinSi
				FinSi
			FinSi
		FinSi
	FinSi
FinAlgoritmo
